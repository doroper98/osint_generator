   "notes": ""
  },
  {
   "claim_id": "clm_0012",
   "text": "같은 10월 19일 상무부 등은 드론 관련 품목 수출통제 조정(제49호)을 발표했고 11월 18일 시행한다",
   "source_ids": [
    "src_doc_0003",
    "src_art_0005"
   ],
   "status": "verified",
   "contested": false,
   "checks": [
    "quote_match:src_doc_0003",
