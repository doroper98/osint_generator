    "src_doc_0006",
    "src_doc_0007"
   ],
   "status": "verified",
   "contested": false,
   "checks": [
    "quote_match:src_doc_0006",
    "quote_match:src_doc_0007",
    "independent_origins:2"
   ],
   "attributed_only": false,
   "claim_kind": "fact",
   "notes": ""
  },
  {
   "claim_id": "clm_0006",
   "text": "헌법 1조: 하원 임기 2년(435석 전원을 2년마다), 상원 임기 6년(세 무리로 나눠 2년마다 3분의 1)",
   "source_ids": [
    "src_doc_0003",
    "src_doc_0006"
   ],
   "status": "verified",
   "contested": false,
   "checks": [
    "quote_match:src_doc_0003",
    "quote_match:src_doc_0006",
    "independent_origins:2"
   ],
   "attributed_only": false,
   "claim_kind": "fact",
   "notes": ""
  },
  {
   "claim_id": "clm_0007",
   "text": "연방주의자 논설 52편(1788): 하원은 국민에게 직접 기대고 국민과 긴밀히 공감해야 하며 잦은 선거가 그 유일한 방법",
   "source_ids": [
    "src_doc_0004"
   ],
   "status": "verified",
   "contested": false,
   "checks": [
    "quote_match:src_doc_0004",
