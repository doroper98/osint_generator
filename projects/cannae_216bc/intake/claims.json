        "official:src_doc_0011",
        "supplement:supp_v3"
      ],
      "attributed_only": false,
      "claim_kind": "fact",
      "notes": ""
    },
    {
      "claim_id": "clm_0043",
      "text": "존 트럼불은 1773년 「칸나이 전투에서 파울루스 아이밀리우스의 죽음」을 그렸고, 이 그림은 예일대학교 미술관 소장이다",
      "source_ids": [
        "src_doc_0011"
      ],
      "status": "verified",
