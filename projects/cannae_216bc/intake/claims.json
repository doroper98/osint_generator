        "independent_origins:1",
        "official:src_doc_0005"
      ],
      "attributed_only": false,
      "claim_kind": "fact",
      "notes": ""
    },
    {
      "claim_id": "clm_0039",
      "text": "한니발 대리석 흉상은 1667년 카푸아에서 발견됐다",
      "source_ids": [
        "src_doc_0011"
      ],
