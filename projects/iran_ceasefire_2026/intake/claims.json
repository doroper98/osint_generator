   "claim_kind": "fact",
   "notes": "",
   "event_date": "2026-10-30"
  },
  {
   "claim_id": "clm_0034",
   "text": "10월 31일 아라그치가 밝힌 조건 — 양해각서 뒤 부과된 제재 해제·역내 미군 축소·원유 제재 면제 복원·카타르 보관분 포함 동결 자금 전액 해제·오만과 합의한 항로 인정",
   "source_ids": [
    "src_art_0001"
   ],
   "status": "corroborated",
   "contested": false,
   "checks": [
    "quote_match:src_art_0001",
    "independent_origins:1",
    "supervisor_table:D-0451"
