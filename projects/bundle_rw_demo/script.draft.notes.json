  "chapters": [
    {
      "scene": "sc01",
      "title": "되찾기 시작한 전선, 그 출발은 패배의 한복판이었다"
    },
    {
      "scene": "sc01",
      "title": "포탄이 모자란 3년, 우크라이나는 어떻게 몰렸나"
    },
    {
      "scene": "sc02",
      "title": "이 전환을 밀어붙인 사람들, 그리고 맞은편"
    },
    {
      "scene": "sc02",
      "title": "스타링크와 종전 압박, 전장 밖의 두 변수"
    },
    {
      "scene": "sc03",
      "title": "포탄 한 발 값으로 전차를 잡는 셈법"
    },
    {
      "scene": "sc03",
      "title": "전선 40km를 삼킨 보이지 않는 화력망"
    },
    {
      "scene": "sc03",
      "title": "전선 너머를 때리다, 스파이더웹에서 40일 작전까지"
    },
    {
      "scene": "sc03",
      "title": "이제 땅 위에서도 사람을 빼낸다"
    },
    {
      "scene": "sc03",
      "title": "되찾기인가 버티기인가, 그리고 로봇이 채울 수 없는 자리"
    },
    {
      "scene": "sc03",
      "title": "전선은 멈추지 않고, 협상의 시계만 빨라진다"
    }
  ],
