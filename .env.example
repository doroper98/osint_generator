# Phase 0+. 실제 값은 .env로 복사 후 채우고 절대 커밋 금지.

# Anthropic / OpenAI API keys (Phase 3+ Agent에서 사용)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram Bot (Phase 1 후속, 주제 입력 수신용)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# YouTube Data API (Phase 11)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRET_PATH=

# Google Drive (사용자 자료 위임 수집용, Phase 4 후속)
GOOGLE_DRIVE_CLIENT_SECRET_PATH=

# 임의 commit-msg 검증 우회 (rebase/cherry-pick 시에만)
SKIP_VERSION_CHECK=0
