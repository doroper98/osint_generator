# .env.example — 실제 키 X. 본인 .env 만들 때 본 파일을 복사하여 채우십시오.
# .env 는 .gitignore 에 포함되어 커밋되지 않습니다 (CLAUDE.md C9).
#
# 사용법 (v0.32.1+):
#   1. copy .env.example .env  (Windows) / cp .env.example .env (Linux)
#   2. 아래 값을 본인 실제 값으로 교체.
#   3. 이후 모든 `python -m orchestrator.main ...` 가 자동 로드.
#      (이미 환경에 같은 키가 export 되어 있으면 그쪽이 우선.)

# ─── ElevenLabs TTS (build-audio --backend elevenlabs) ───────────────────────
# https://elevenlabs.io/app/settings/api-keys 에서 발급.
ELEVENLABS_API_KEY=
# 본인 voice id (https://elevenlabs.io/app/voice-library).
# 비우면 premade voice 사용 — 무료 플랜은 본인 생성 voice 만 허용(402 가능).
ELEVENLABS_VOICE_ID=
# (선택) 기본 eleven_multilingual_v2 (한국어 지원).
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# (선택) 기본 mp3 (무료 가능). 정밀 길이 필요 시 pcm_16000.
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# ─── Forced-alignment (자막 정밀 싱크, 선택) ─────────────────────────────────
# 미설정/none → 비례 폴백 (현재 디폴트).
# whisper      → Whisper 단어 타임스탬프(모델 가중치 필요, 사용자 머신).
# OSINT_ALIGN_BACKEND=whisper
# OSINT_ALIGN_WHISPER_MODEL=base

# ─── LLM Bridge ──────────────────────────────────────────────────────────────
# 본 시스템은 사용자 구독의 `claude` / `codex` CLI 를 subprocess 로 호출하므로
# 별도 API 키 불필요 (CLAUDE.md C10, ADDENDUM_04).
# 빠른 테스트는:
# OSINT_LLM_STUB=1

# ─── (장래) Telegram / YouTube / Drive — 현재 미사용 ─────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_CHAT_ID=
# YOUTUBE_API_KEY=
# GOOGLE_DRIVE_CLIENT_SECRET_PATH=

# ─── Git hook 우회 (rebase/cherry-pick 시에만) ───────────────────────────────
# SKIP_VERSION_CHECK=1
