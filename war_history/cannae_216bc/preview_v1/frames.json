   "file": "p_0031.48.png",
   "label": "t=31.48",
   "t": 31.48,
   "sid": "cold_open_4",
   "text": "반면 카르타고군은 보병 약 4만 명, 기병 약 1만 명이었습니다.",
   "after_sid": null,
   "card": null,
   "events": []
  },
