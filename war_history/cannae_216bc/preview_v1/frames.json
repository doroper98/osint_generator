   "n": 11,
   "file": "p_0300.56.png",
   "label": "t=300.56",
   "t": 300.56,
   "sid": "aftermath_7",
   "text": "리비우스는 기병대장 마하르발이 한니발에게, 이기는 법은 알아도 승리를 쓰는 법은 모른다고 말했다고 전했습니다.",
   "after_sid": null,
   "card": null,
   "events": [
    {
     "type": "quote"
    }
   ]
  },
